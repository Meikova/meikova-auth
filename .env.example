# Meikova Auth Gateway Environment Configuration
# Local default: 8990, Render default: 10000 (Render automatically sets PORT)
PORT=8990
HOST=0.0.0.0

# Turso Cloud SQLite Database (meikova-auth)
AUTH_TURSO_DATABASE_URL=https://meikova-auth-m3ik18dp.aws-ap-northeast-1.turso.io
AUTH_TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Asymmetric Ed25519 Cryptographic Keys (Inline Base64 for Render / Cloud)
# If left unset, the service automatically loads ./keys/ed25519_private.pem & ./keys/ed25519_public.pem
AUTH_PUBLIC_KEY_B64=LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUNvd0JRWURLMlZ3QXlFQUFCekI5L2Y4MnF1T29VTndOaWhOeWxYS1I0ZUhDRE5YTEtQL2Y4ZEwxbmc9Ci0tLS0tRU5EIFBVQkxJQyBLRVktLS0tLQo=
AUTH_PRIVATE_KEY_B64=your_base64_encoded_private_key_for_render

# Allowed CORS Origins (* for open ecosystem)
CORS_ORIGINS=*
